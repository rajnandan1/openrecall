{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v openrecall >/dev/null 2>&1 || { printf '%s\\n' '{\"systemMessage\": \"OpenRecall is off: no openrecall on PATH. Install: curl -fsSL https://raw.githubusercontent.com/rajnandan1/openrecall/main/install.sh | sh\"}'; exit 0; }; exec openrecall handoff"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "openrecall",
            "args": [
              "recall"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "openrecall",
            "args": [
              "deliver"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "openrecall",
            "args": [
              "capture"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "openrecall",
            "args": [
              "extract"
            ],
            "timeout": 5
          }
        ]
      }
    ]
  }
}
